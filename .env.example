# PhamaCount Web 環境變數範例
# 複製此檔案為 .env.local 並填入實際值

# =============================================================================
# Supabase (必填) - 從 Supabase 專案設定 > API 取得
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Google Gemini AI (必填) - 從 Google AI Studio 取得
# 用於 OCR 備援模型、NHI 查詢等
# =============================================================================
GOOGLE_API_KEY=your-google-api-key

# =============================================================================
# NVIDIA Nemotron (選填，強烈建議設定) - 從 NVIDIA NGC 取得
# 用於 OCR 主要模型 (Nemotron-3-Nano-Omni)
# 格式: nvapi-xxxxxxxxxxxx
# 未設定時會自動降級使用 Gemini
# =============================================================================
NVIDIA_API_KEY=nvapi-your-nvidia-api-key

# =============================================================================
# Google Drive 整合 (選填) - 用於雲端備份
# 從 Google Cloud Console 建立 OAuth 2.0 憑證
# =============================================================================
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/auth/gdrive/callback

# =============================================================================
# Backblaze B2 (選填) - 用於照片備份儲存
# =============================================================================
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
B2_BUCKET_ID=your-bucket-id

# =============================================================================
# Cloudflare CDN for B2 (選填) - 代理 B2 下載流量，減少 Class B 交易
# 在 Cloudflare 設定 CNAME 代理 s3.{region}.backblazeb2.com
# =============================================================================
NEXT_PUBLIC_B2_CDN_HOST=b2.yourdomain.com

# =============================================================================
# 應用程式設定
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development